{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":enablePreCommit"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "rangeStrategy": "update-lockfile",
  "labels": ["renovate"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["pyproject.toml"],
      "matchStrings": [
        "version\\s*=\\s*\"(?<currentValue>[0-9.]+)\"\\s*#\\s*renovate:\\s*depName=(?<depName>[^\\s]+)\\s+datasource=(?<datasource>[^\\s]+)"
      ],
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["pyproject.toml"],
      "matchStrings": [
        "Programming Language :: Python :: (?<currentValue>[0-9.]+)\",\\s*#\\s*renovate:\\s*customPinnedDependency=python,\\s*datasource=python-version"
      ],
      "depNameTemplate": "python",
      "datasourceTemplate": "python-version",
      "versioningTemplate": "python",
      "autoReplaceStringTemplate": "Programming Language :: Python :: {{{currentValue}}}\",\n    \"Programming Language :: Python :: {{{newValue}}}\", # renovate: customPinnedDependency=python,datasource=python-version"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [".pre-commit-config.yaml"],
      "matchStrings": [
        "\\s-\\s(?<depName>[A-Za-z0-9][A-Za-z0-9._-]*)==(?<currentValue>[^\\s#]+)"
      ],
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "addLabels": ["dependencies"]
    },
    {
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "matchManagers": ["pre-commit", "devcontainer"],
      "matchUpdateTypes": ["major"],
      "automerge": true
    },
    {
      "matchPackageNames": ["uv"],
      "matchUpdateTypes": ["major"],
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["github_actions"]
    },
    {
      "matchManagers": ["pep621"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Keep the mypy hook pins consistent with each other and pyproject",
      "matchManagers": ["pep621", "custom.regex"],
      "matchDatasources": ["pypi"],
      "matchFileNames": ["pyproject.toml", ".pre-commit-config.yaml"],
      "matchPackageNames": ["!uv"],
      "groupName": "python dependencies"
    },
    {
      "description": "New Python releases (3.x -> 3.y is a minor update for Renovate) are adopted deliberately, in step with Home Assistant",
      "matchDepNames": ["python"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "Same for the Python version of the devcontainer image",
      "matchPackageNames": ["mcr.microsoft.com/devcontainers/python"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  }
}
